{
  "name": "atom-webui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:api": "openapi-typescript ../docs/api/openapi.yaml --default-non-nullable false -o src/api/schema.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build": "node ../scripts/build-webui.mjs",
    "build:package": "node ../scripts/build-webui.mjs --package"
  },
  "dependencies": {
    "@tanstack/vue-table": "^8.21.3",
    "@tanstack/vue-virtual": "^3.13.52",
    "openapi-fetch": "^0.15.0",
    "vue": "^3.5.22",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "openapi-typescript": "^7.10.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vue-tsc": "^3.1.1"
  }
}
